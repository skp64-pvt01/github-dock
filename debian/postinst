#!/bin/bash
set -e

case "$1" in
  configure)
    # Create gitdock user (system account, no login shell)
    if ! getent passwd gitdock >/dev/null 2>&1; then
      adduser --system --group --home /opt/gitdock --no-create-home \
        --disabled-login --quiet gitdock 2>/dev/null || true
    fi

    # Install npm dependencies if not already present
    if [ -f /opt/gitdock/package.json ] && [ ! -d /opt/gitdock/node_modules ]; then
      cd /opt/gitdock && npm install --omit=dev --no-audit --no-fund 2>&1 | tail -3 || true
    fi

    # Set ownership
    chown -R gitdock:gitdock /opt/gitdock 2>/dev/null || true
    chmod 755 /opt/gitdock
    chmod 644 /opt/gitdock/*.js /opt/gitdock/*.json /opt/gitdock/*.md /opt/gitdock/*.html 2>/dev/null || true
    chmod 755 /opt/gitdock/start.sh 2>/dev/null || true

    # Ensure log directory exists
    mkdir -p /var/log/gitdock
    chown gitdock:gitdock /var/log/gitdock
    chmod 755 /var/log/gitdock

    # NOTE: Do not enable or start the system service by default during package
    # installation. Users may prefer to run GitDock as a per-user service or
    # explicitly enable the system service. The helper utility `gitdockctrl`
    # can be used to install/enable/start the desired service mode.

    # The postinst intentionally avoids starting the system unit. Admins who
    # wish to enable the system service should run:
    #   sudo systemctl enable --now gitdock
    # Or use the provided helper script (after installing the package):
    #   /usr/local/bin/gitdockctrl install  # run as root to install system unit
    # The helper is installed to /usr/local/bin by the package (dh_install).

    # If /usr/local/bin/gitdockctrl exists, ensure it is executable
    if [ -f /usr/local/bin/gitdockctrl ]; then
      chmod 755 /usr/local/bin/gitdockctrl 2>/dev/null || true
    fi
    ;;
esac
